{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fun-toolkit",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "fun-toolkit-production",
    "database_id": "632b90b1-b9d7-4d72-8d3d-7b138f11c6c5",
    "migrations_dir": "migrations"
  }]
}
